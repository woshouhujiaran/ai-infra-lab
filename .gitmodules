	url = https://github.com/bitsandbytes-foundation/bitsandbytes.git
[submodule "upstream/streaming-llm"]
	path = upstream/streaming-llm
	url = https://github.com/mit-han-lab/streaming-llm.git
[submodule "upstream/Liger-Kernel"]
	path = upstream/Liger-Kernel
